{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo test)",
      "Bash(cargo build *)",
      "Bash(cargo build)",
      "Bash(bash scripts/verify-linux.sh *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1 *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(cargo fmt *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo test)",
      "PowerShell(cargo build *)",
      "PowerShell(cargo build)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1 *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1)",
      "PowerShell(git status *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git diff)",
      "PowerShell(git log *)",
      "PowerShell(git log)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git tag *)",
      "Bash(git tag)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(find * -delete *)",
      "PowerShell(git push *)",
      "PowerShell(git push)",
      "PowerShell(git tag *)",
      "PowerShell(git tag)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git reset --hard)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Bash(cat *.env*)",
      "Bash(cat */.env*)",
      "PowerShell(Get-Content *.env*)"
    ]
  }
}
